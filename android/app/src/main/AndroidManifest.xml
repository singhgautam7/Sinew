<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- Timer: the foreground service that keeps a running timer and its cues
         alive with the screen off (flutter_foreground_task README, Android).
         No INTERNET permission, ever (offline guarantee). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- Android 14+: a service type is mandatory, and its permission with it.
         A workout interval timer fits none of the named types (health needs
         body-sensor permissions), so it declares special use below. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Android 13+: needed for the service's ongoing notification. Asked for
         at the first timer start, not at launch. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Keeps the CPU awake while a timer runs with the screen off, and the
         screen on while the run screen is open (wakelock_plus). -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Haptic cues. -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- flutter_foreground_task merges this in for its restart-after-boot
         feature. A workout timer must never come back after a reboot, so the
         permission and the receivers below are removed from the merged
         manifest (the Dart side also sets allowAutoRestart: false). -->
    <uses-permission
        android:name="android.permission.RECEIVE_BOOT_COMPLETED"
        tools:node="remove" />

    <application
        android:label="Sinew"
        android:name=".SinewApplication"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:enableOnBackInvokedCallback="true"
        android:allowBackup="true"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules">
        <receiver
            android:name="com.pravera.flutter_foreground_task.service.RebootReceiver"
            tools:node="remove" />
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- Do not rename: the plugin starts this class by name. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Workout interval timer: keeps counting down and sounding cues while the screen is off" />
        </service>
        <!-- Monochrome small icon of the timer notification
             (NotificationIcon.metaDataName in the Dart host). -->
        <meta-data
            android:name="com.grs.sinew.service.TIMER_ICON"
            android:resource="@drawable/ic_stat_timer" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ package visibility: without this TextToSpeech cannot
             bind to the phone's speech engine and spoken cues stay silent. -->
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE"/>
        </intent>
    </queries>
</manifest>
