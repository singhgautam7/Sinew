<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup and device-to-device transfer on Android 12 and up. The same
     two items as backup_rules.xml, for the same reasons: the user database's
     main file (not its -wal or -shm) and the settings. Never the library. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="root" path="app_flutter/sinew_user.sqlite" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter/sinew_user.sqlite" />
        <include domain="sharedpref" path="FlutterSharedPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
