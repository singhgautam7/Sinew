{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sinew.fit/schema/flow.schema.json",
  "title": "SinewFlowRecord",
  "description": "Schema for Sinew guided sequence and timer flow templates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "name",
    "category",
    "difficulty",
    "description",
    "totalDurationSec",
    "rounds",
    "items",
    "tags"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 100
    },
    "category": {
      "type": "string",
      "enum": [
        "strength",
        "calisthenics",
        "yoga",
        "mobility",
        "hiit",
        "boxing",
        "cardio",
        "pilates"
      ]
    },
    "difficulty": {
      "type": "string",
      "enum": ["beginner", "intermediate", "advanced"]
    },
    "description": {
      "type": "string"
    },
    "totalDurationSec": {
      "type": "integer",
      "minimum": 30
    },
    "rounds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "items": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exerciseId", "durationSec", "transitionSec"],
        "properties": {
          "exerciseId": {
            "type": "string",
            "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
          },
          "durationSec": {
            "type": "integer",
            "minimum": 5
          },
          "transitionSec": {
            "type": "integer",
            "minimum": 0
          },
          "notes": {
            "type": ["string", "null"]
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
